# Application Settings
PORT=5000
DATABASE_URL="file:./dev.db" # Or "postgresql://postgres:password@localhost:5432/healthcare_db?schema=public"
JWT_SECRET="super_secret_jwt_key_here_change_in_production"

# LLM Integration (Google Gemini API)
GEMINI_API_KEY="your-google-gemini-api-key-here"
LLM_TIMEOUT_MS=5000

# Email Integration (SendGrid / Nodemailer / SMTP / Console)
EMAIL_DRIVER="console" # Options: console, smtp
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-password"

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"
